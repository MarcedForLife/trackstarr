# Local development environment. Copy to .env; it is gitignored, loaded at
# startup by config.py, and never overrides a variable already set. The image
# ships no .env. Every setting is listed in the README under "Configuration".

# Working and state directories for a checkout, under the gitignored dev/.
WORK_DIR=./dev/data
STATE_DIR=./dev/config

# The built web UI, written by `npm run build` in web/. Leave unset for
# development: dev.py runs Vite, which serves the pages with hot reload.
# WEB_DIR=./web/build

# The *arrs, for a title's original language; empty disables each. A _FILE
# variant works too, see the README. Setting one here pins it in the UI.
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=
# SONARR_URL=http://localhost:8989
# SONARR_API_KEY=

# Media servers to refresh after each rewrite; empty disables each. The refresh
# names a path, so map the difference when the server mounts the library
# elsewhere: comma-separated LOCAL=REMOTE, longest local prefix winning.
# PLEX_URL=http://localhost:32400
# PLEX_TOKEN=
# PLEX_PATH_MAP=/data/media=/srv/media
# JELLYFIN_URL=http://localhost:8096
# JELLYFIN_API_KEY=
# JELLYFIN_PATH_MAP=/data/media=/srv/media

# IMDb's ratings dataset, one 8MB file fetched daily for the title scores. No
# key needed. Set false to make no outbound request.
# IMDB_RATINGS=true

# The admin's starting password, applied only when no users exist. Unset, one
# is generated and logged at first start.
# ADMIN_PASSWORD=

# The zone for the schedule, the log and event stamps. A checkout inherits your
# shell's; setting it here pins it in the UI.
# TZ=Pacific/Auckland

# The rewrite ladder: "report" rewrites nothing (even `sweep --apply`),
# "imports" rewrites what the *arrs import, "all" lets the sweep rewrite too.
# Setting it here pins it in the UI.
# REWRITE_MODE=report
