# Local development environment. Copy to .env; it is gitignored and loaded at
# startup by config.py, and never overrides a variable already set. The image
# ships no .env and sets these through the environment instead. The full list
# of settings and their defaults is in the README under "Configuration".

# Working and state directories for a source checkout, so a run never touches a
# real /data or /config. Both live under dev/, which is gitignored.
WORK_DIR=./dev/data
STATE_DIR=./dev/config

# The built web UI, served on GETs the API doesn't claim; `npm run build` in
# web/ writes it there. Leave unset for development: the dev launcher runs Vite,
# which owns the pages and proxies /api here, so you get hot reload instead.
# WEB_DIR=./web/build

# Point at your *arrs to resolve a title's original language; empty disables
# each. A file naming variant works too, see the README.
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=
# SONARR_URL=http://localhost:8989
# SONARR_API_KEY=

# A media server to nudge after each rewrite, so track lists stay correct even
# on mounts its own watcher can't see; empty disables each. The refresh names a
# path, so the server has to know the library by the same one, and a checkout
# almost guarantees it doesn't: MEDIA_DIRS still says /data/media here while a
# real Plex says wherever you mounted it. Comma-separated LOCAL=REMOTE, one pair
# per library that differs, longest local prefix winning.
# PLEX_URL=http://localhost:32400
# PLEX_TOKEN=
# PLEX_PATH_MAP=/data/media=/srv/media
# JELLYFIN_URL=http://localhost:8096
# JELLYFIN_API_KEY=
# JELLYFIN_PATH_MAP=/data/media=/srv/media

# Plan everywhere and rewrite nothing, to watch a real week before it acts.
# DRY_RUN=true
